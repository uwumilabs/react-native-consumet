#!/bin/sh
set -e

# Lint and format the staged files only. lint-staged re-stages its own fixes, leaves unstaged
# changes alone, and fails the commit on ESLint errors.
npx --no-install lint-staged

echo "Type-checking..."
yarn typecheck

# dist/ is committed: rebuild and stage it when the sources or build scripts change.
if git diff --cached --name-only | grep -qE '^(src/|scripts/)'; then
  echo "src/ or scripts/ changed, rebuilding dist/..."
  yarn build:clean
  git add -A dist
fi
