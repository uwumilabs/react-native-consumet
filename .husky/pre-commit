#!/bin/sh
set -e

# Lint and format the staged files only. lint-staged re-stages its own fixes, leaves unstaged
# changes alone, and fails the commit on ESLint errors.
npx --no-install lint-staged

echo "Type-checking..."
yarn typecheck

# dist/, registry/ and the example app's local dist map are committed. When what they are built
# from is staged, rebuild them from the staged files and stage the result (scripts/stage-dist.js).
# Fails if a bundle changed under a version that is already published.
node scripts/stage-dist.js
