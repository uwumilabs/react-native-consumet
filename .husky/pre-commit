#!/bin/sh
set -e

# Lint and format the staged files only. lint-staged re-stages its own fixes, leaves unstaged
# changes alone, and fails the commit on ESLint errors.
npx --no-install lint-staged

echo "Type-checking..."
yarn typecheck

# dist/ and registry/ are committed. When src/, scripts/ or the build config are staged, rebuild
# dist/ from the staged files, publish new versions and refresh hashes, and stage the result.
# Fails if a bundle changed under a version that is already published.
node scripts/stage-dist.js
